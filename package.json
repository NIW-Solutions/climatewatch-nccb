{
  "name": "climatewatch-nccb",
  "version": "1.0.0",
  "private": true,
  "description": "Official website of ClimateWatch, a youth-led climate think tank working across international climate policy, research and development.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "clean": "node -e \"const fs=require('fs');['.next','out'].forEach((dir)=>fs.rmSync(dir,{recursive:true,force:true}))\"",
    "build:clean": "npm run clean && npm run build",
    "prebuild": "npm run check",
    "blur": "node scripts/generate-image-blur.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
